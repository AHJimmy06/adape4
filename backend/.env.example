# Copia este archivo a backend/.env y completa los valores localmente.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=
JWT_SECRET=
JWT_EXPIRES_MINUTES=60
PORT=5000


# Orígenes web adicionales separados por comas; sin barra final.
# localhost y 127.0.0.1 por HTTP están permitidos para Flutter Web local.
CORS_ALLOWED_ORIGINS=
